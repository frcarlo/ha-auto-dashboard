{
  "name": "ha-auto-dashboard",
  "version": "0.1.1",
  "description": "Schlanke Lovelace-Strategy, die ein Dashboard aus Areas, Floors und Entities erzeugt",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "push": "npm run build && node scripts/push-inline.mjs",
    "serve": "vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
