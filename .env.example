# Ziel für das Bundle, z. B. ein Samba-Mount von /config/www oder ein scp-Ziel
HA_WWW_TARGET=/mnt/ha-config/www/auto-dashboard
# alternativ: HA_WWW_TARGET=root@homeassistant.local:/config/www/auto-dashboard

# Für npm run push (Inline-Resource per WebSocket, kein Dateizugriff nötig)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=langlebiger-zugriffstoken
